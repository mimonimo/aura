# AURA 서버 환경 — deploy/install.sh 가 이 틀로 .env.local 을 만든다(0600, 깃에 넣지 않음).
# 주소·키 대부분은 설치 뒤 개발 화면 「도구·모델 연결」(/dev/tools)의 「LLM 연결」·「서버 설정」에서 정한다.
# 여기에는 서버가 뜨는 데 꼭 필요한 값만 둔다. 바꾼 뒤에는 systemctl --user restart zzaimy

# 웹 서버 — 0.0.0.0 으로 열려면 TLS 인증서가 있어야 한다(없으면 127.0.0.1 만, 앞단 프록시를 둘 때)
ZZAIMY_HOST=@HOST@
ZZAIMY_PORT=@PORT@
ZZAIMY_PUBLIC_URL=@PUBLIC_URL@
ZZAIMY_TLS_CERT=@TLS_CERT@
ZZAIMY_TLS_KEY=@TLS_KEY@
# 계정 로그인 켜기 — 첫 기동 때 담당자(zzaimy) 계정의 비밀번호. 개발자(zzdev) 첫 비밀번호는 data/platform 아래 파일에 남는다
ZZAIMY_PASSWORD=@BOOT_PASSWORD@

# 데이터 — 원본·처리 결과·색인·생성 문서가 모두 이 아래
ZZAIMY_DATA_DIR=@DATA_DIR@

# DB — 비우면 시험용 SQLite(data/platform/platform.db). 운영은 PostgreSQL(pgvector)
ZZAIMY_DATABASE_URL=@DATABASE_URL@
ZZAIMY_DATABASE_SCHEMA=@DATABASE_SCHEMA@

# 앱 서버에서 모델을 내려받지 않는다(폐쇄망) — CPU 비상용 임베딩·리랭커는 설치 묶음의 캐시를 쓴다
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
