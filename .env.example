# ZZAIMY 환경 설정 예시. 복사해 .env.local 로 쓰고, .env.local 은 커밋하지 않는다(.gitignore).
# 운영 서버는 systemd EnvironmentFile 로 읽는다. 측정·배치 스크립트를 직접 실행할 때는
# `set -a; . ./.env.local; set +a` 로 먼저 읽는다. 서빙 주소가 비어 있으면 CPU 베이스 모델로 대신 돌아
# 측정 수치가 운영과 달라진다.

# 데이터 루트. 실제 문서·처리 결과·색인은 모두 이 아래에 둔다.
ZZAIMY_DATA_DIR=./data

# 운영 DB(PostgreSQL). 비워 두면 로컬 시험용 SQLite(data/platform/platform.db)를 쓴다.
# 스키마 이름은 aura_app_* 또는 aura_test_* 꼴이어야 한다.
# ZZAIMY_DATABASE_URL=postgresql://<사용자>@<호스트>/<DB>
# ZZAIMY_DATABASE_SCHEMA=aura_app_main

# 검색 모델 서비스(ZZAIMY-Embed·ZZAIMY-Rerank 학습본)
ZZAIMY_EMBED_URL=http://<임베딩 서버>:8016/embed
ZZAIMY_RERANK_URL=http://<리랭커 서버>:8015/score
ZZAIMY_RERANK_MIN=0.005          # 근거로 인정하는 리랭커 점수 하한. 모델을 바꾸면 scripts/105 로 다시 잰다(ADR-0020)
ZZAIMY_RERANK_DEVICE=cpu         # 리랭커 서비스가 응답하지 않을 때 이 서버에서 대신 돌리는 장치

# Writer 모델(vLLM, OpenAI 호환). 개발자 화면의 연결 설정에 등록한 값이 우선이고,
# 등록된 연결이 없을 때 이 값을 쓴다.
VLLM_BASE_URL=http://<Writer 서버>:8001/v1
VLLM_API_KEY=dummy

# 웹 서버. 기본은 127.0.0.1:8800 이다.
# 127.0.0.1 밖으로 열려면 비밀번호와 TLS 인증서가 모두 필요하다. 비밀번호를 주면 계정 로그인이 켜진다.
# ZZAIMY_PORT=8800
# ZZAIMY_HOST=0.0.0.0
# ZZAIMY_PASSWORD=
# ZZAIMY_TLS_CERT=/path/fullchain.pem
# ZZAIMY_TLS_KEY=/path/privkey.pem
# ZZAIMY_PUBLIC_URL=https://<서비스 주소>

# 외부 검색 모드(선택). 키가 있으면 Google 맞춤 검색이나 네이버 검색 API를, 없으면 DuckDuckGo 를 쓴다.
# ZZAIMY_GOOGLE_CSE_KEY=
# ZZAIMY_GOOGLE_CSE_CX=
# ZZAIMY_NAVER_CLIENT_ID=
# ZZAIMY_NAVER_CLIENT_SECRET=
# ZZAIMY_WEB_SEARCH=google      # google | naver | duckduckgo 로 고정

# 문서 판독 제한 시간(초, 선택). 기본값은 코드에 있다.
# ZZAIMY_VISION_TIMEOUT=600
# ZZAIMY_REVIEW_TIMEOUT=600
# ZZAIMY_MINERU_TIMEOUT=600

# 주간 보고 자동 작성을 끄려면
# ZZAIMY_WEEKLY_AUTO=0
