# 실제 값은 .env.local 에 두고 커밋하지 않는다(.gitignore). 운영 VM 은 systemd EnvironmentFile 로 읽는다.
# 측정·배치 스크립트를 손으로 띄울 때는 `set -a; . ./.env.local; set +a` 를 먼저 한다 —
# 서빙 주소가 비면 코드가 조용히 VM CPU 베이스 모델로 물러나 수치가 거짓이 된다.

# 데이터 루트 — 실제 문서·파싱 결과·색인은 전부 이 아래에만 둔다
ZZAIMY_DATA_DIR=./data

# 검색 모델 서비스 (토르 03, 학습본) — HANDOFF §1
ZZAIMY_EMBED_URL=http://211.170.162.121:8016/embed
ZZAIMY_RERANK_URL=http://211.170.162.121:8015/score
ZZAIMY_RERANK_MIN=0.005          # 근거 하한 — 리랭커 모델을 바꾸면 scripts/105 로 다시 잰다(ADR-0020)
ZZAIMY_RERANK_DEVICE=cpu         # 서비스가 죽었을 때의 VM 폴백

# LLM 연결은 화면(개발자 > 연결)에서 등록한 값이 우선이다(data/platform/llm_connections.json).
# 아래는 연결 파일이 없을 때의 기본값.
VLLM_BASE_URL=http://211.170.162.120:8001/v1
VLLM_API_KEY=dummy

# 웹 (선택)
ZZAIMY_PORT=8080
# ZZAIMY_TLS_CERT=/path/fullchain.pem
# ZZAIMY_TLS_KEY=/path/privkey.pem

# 문서 판독 (선택) — 기본값은 코드에 있다
# ZZAIMY_VISION_TIMEOUT=600
# ZZAIMY_REVIEW_TIMEOUT=600
# ZZAIMY_MINERU_TIMEOUT=600

# 주간 보고 자동 작성을 끄려면
# ZZAIMY_WEEKLY_AUTO=0
