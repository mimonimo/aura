# 장비 접속 정보 — configs/hosts.env 로 복사해 값을 채운다.
# configs/hosts.env 는 .gitignore 에 있다. 실제 주소·계정·포트는 저장소에 넣지 않는다.
# 셸 스크립트는 scripts/_hosts.sh, 파이썬은 zzaimy.hosts 가 읽는다.
# 같은 이름의 환경 변수(.env.local 포함)가 있으면 그쪽이 먼저다.

# 운영 VM
ZZAIMY_VM_SSH=user@vm-host
# 서빙 장비 02(문서 작업)·03(판독·검색)
ZZAIMY_THOR02_SSH=user@thor02-host
ZZAIMY_THOR03_SSH=user@thor03-host
ZZAIMY_THOR_SSH_PORT=22
# 학습 장비(원본 보관소)
ZZAIMY_DGX_SSH=user@dgx-host
ZZAIMY_DGX_SSH_PORT=22
